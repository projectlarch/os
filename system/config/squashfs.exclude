# Paths left out of every layer's squashfs (stage 8: mksquashfs -wildcards -ef).
# Patterns are relative to the rootfs root; * doesn't match a leading dot,
# so dotfiles need their own .* line; "... <pattern>" matches at any depth.
#
# The mount points themselves stay in the image (nothing can be created on the
# read-only root at boot); only their contents go.

# Build-chroot leftovers, covered at boot by devtmpfs, tmpfs and proc/sysfs.
dev/*
dev/.*
run/*
run/.*
tmp/*
tmp/.*
proc/*
sys/*

# The default user's /home/larch; LARCHHOME is mounted over /home.
home/*
home/.*

# Whatever lands in /boot (nothing, with kernel-install's plugins off): the kernel ships as the
# release's vmlinuz (stage 11) and boots from LARCHEFI, so a copy here is never used.
boot/*
boot/.*

root/.cache

# Fedora keeps the kernel image beside its modules; it ships as the release's
# vmlinuz (stage 11, taken from the base), so the layers don't need a copy.
usr/lib/modules/*/vmlinuz

# The package databases: kept in the build trees, where each layer above the
# base is installed by dnf on top of the base's, but never shipped.
usr/lib/sysimage/rpm
usr/lib/sysimage/libdnf5
var/lib/rpm
var/lib/dnf
